{
    "title": "Tandoori Chicken",
    "meta": "2 day process.",
    "ingredients": [
        { "text": "12 chicken thighs", "type": "meat" },
        { "text": "2 lemons", "type": "produce" },
        { "text": "3 limes", "type": "produce" },
        { "text": "1 TBSP minced peeled ginger root", "type": "produce" },
        { "text": "1 minced garlic", "type": "produce" },
        { "text": "2 tsp coriander", "type": "spice" },
        { "text": "2 tsp cumin", "type": "spice" },
        { "text": "2 tsp garam masala", "type": "spice" },
        { "text": "1 tsp cayenne pepper", "type": "spice" },
        { "text": "1 &frac12; tsp salt", "type": "spice" }
    ],
    "directions": [
        { "text": "Cut large slits in chicken going against the grain." },
        { "text": "Dice ginger root and garlic with spices." },
        { "text": "Rub chicken with spices and squeeze lemon juice on top, put chicken in a small bowl." },
        { "text": "Marinate Chicken for 12 hours." },
        { "text": "Bake chicken with juice and all at 375&deg; for 38 mins." },
        { "text": "Cut limes into fourths and serve with chicken." }
    ]
}
