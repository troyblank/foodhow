{
    "title": "Virgin Margarita",
    "meta": "",
    "ingredients": [
        { "text": "1 lime", "type": "produce" },
        { "text": "6 oz orange juice", "type": "perishable" },
        { "text": "2 oz peach juice", "type": "perishable" },
        { "text": "8 oz ginger ale", "type": "imperishable" },
        { "text": "12 oz frozen limeade", "type": "frozen" },
        { "text": "4 TBSP salt", "type": "spice" },
        { "text": "1 cup ice", "type": "imperishable" }
    ],
    "directions": [
        { "text": "Pour salt onto a small plate, rub rim of a glass with a lime wedge and coat with salt." },
        { "text": "Mix 10 oz water with rest of ingredients minus lime in a blender." },
        { "text": "Serve in salted glass, garnish with lime wedge." }
    ]
}
