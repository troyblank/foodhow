{
    "title": "Smoked Beef Jerky",
    "meta": "6 hour marination. Keeps refrigerated for up to a month",
    "ingredients": [
        { "text": "hickory wood chips", "type": "uncommon" },
        { "text": "2 lb flank steak (pounded to &frac12;″)", "type": "meat" },
        { "text": "&frac12; cup soy sauce", "type": "imperishable" },
        { "text": "&frac12; cup apple cider vinegar", "type": "imperishable" },
        { "text": "&frac14; cup worcestershire sauce", "type": "imperishable" },
        { "text": "2 TBSP dry minced onion", "type": "spice" },
        { "text": "1 TBSP honey", "type": "imperishable" },
        { "text": "1 tsp liquid smoke", "type": "imperishable" },
        { "text": "2 tsp black pepper", "type": "spice" },
        { "text": "1 tsp red pepper flakes", "type": "spice" }
    ],
    "directions": [
        { "text": "Cut meat across the grain into small strips." },
        { "text": "In a shallow dish mix all ingredients but wood chips and add meat." },
        { "text": "Refrigerate for 6 hours." },
        { "text": "Pat meat dry with paper towels and sprinkle with some additional black pepper." },
        { "text": "Smoke meat with hickory chips at 180° for 4&frac12; hours." }
    ]
}
