{
    "title": "Sangria",
    "meta": "",
    "ingredients": [
        { "text": "1 lemon", "type": "produce" },
        { "text": "1 lime", "type": "produce" },
        { "text": "1 orange", "type": "produce" },
        { "text": "6 oz pineapple juice", "type": "imperishable" },
        { "text": "&frac14; cup lemon juice", "type": "produce" },
        { "text": "&frac13; cup frozen lemonade concentrate", "type": "frozen" },
        { "text": "&frac14; cup agave sugar", "type": "imperishable" },
        { "text": "1 pinch cinnamon", "type": "spice" },
        { "text": "1 tsp vanilla extract", "type": "imperishable" },
        { "text": "&frac12 cup brandy", "type": "imperishable" },
        { "text": "&frac12; cup triple sec", "type": "imperishable" },
        { "text": "1 bottle of shiraz red wine", "type": "imperishable" }
    ],
    "directions": [
        { "text": "Chop up fruit and mix ingredients together in a pitcher." },
        { "text": "Marinate overnight." }
    ]
}
