    "@mui/material": "^9.4.0",
    "@tanstack/react-query": "5.102.8",
    "@troyblank/food-how-components": "0.5.1",
    "aws-amplify": "6.20.0",
    "classnames": "2.5.1",
    "dompurify": "3.4.15",
