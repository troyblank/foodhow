{
    "title": "Stuffed Shells",
    "meta": "",
    "ingredients": [
        { "text": "1 lb ground beef", "type": "meat" },
        { "text": "1 white onion diced", "type": "produce" },
        { "text": "1 garlic glove chopped", "type": "produce" },
        { "text": "8 oz of shredded mozzarella", "type": "perishable" },
        { "text": "&frac12; cup grated parmesan cheese", "type": "imperishable" },
        { "text": "8 oz of tomato sauce", "type": "imperishable" },
        { "text": "1 jar of spaghetti sauce", "type": "imperishable" },
        { "text": "18 jumbo pasta shells", "type": "imperishable" },
        { "text": "1 egg beaten", "type": "perishable" },
        { "text": "&frac12; cup Italian bread crumbs", "type": "imperishable" },
        { "text": "&frac14; cup fresh parsley", "type": "produce" },
        { "text": "Salt and pepper to taste", "type": "spice" }
    ],
    "directions": [
        { "text": "Boil pasta al dente." },
        { "text": "Brown ground beef, then add onion and garlic, let cool." },
        { "text": "Combine meat, mozzarella, bread crumbs, egg, parsley, salt, and pepper." },
        { "text": "Mix spaghetti sauce with tomato sauce, use &frac14; of it to cover bottom of a casserole dish." },
        { "text": "Stuff cooked shells with the meat mixture and place in rows in the dish." },
        { "text": "Cover shells with sauce and sprinkle with parmesan." },
        { "text": "Bake for 23 mins at 400&deg;." }
    ]
}