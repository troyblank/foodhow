{
    "title": "Tacos",
    "meta": "",
    "ingredients": [
        { "text": "2 chicken breasts", "type": "meat" },
        { "text": "1 red pepper", "type": "produce" },
        { "text": "1 white onion", "type": "produce" },
        { "text": "3 limes", "type": "produce" },
        { "text": "12 small tortillas", "type": "imperishable" },
        { "text": "8oz of Monterey Jack Cheese", "type": "perishable" },
        { "text": "2 TBSP vegetable oil", "type": "imperishable" },
        { "text": "2 TBSP taco seasoning", "type": "spice" }
    ],
    "directions": [
        { "text": "Boil breasts for 5 mins then cover with oil." },
        { "text": "Cook breasts on grill, 7 mins per side." },
        { "text": "Chop up the onion and pepper into tiny bits place in bowls." },
        { "text": "Grate the cheese and place into bowl." },
        { "text": "Cut up chicken into tiny bits and mix with taco seasoning." },
        { "text": "Heat tortillas in microwave for 15 seconds." },
        { "text": "Serve with sliced limes." }
    ]
}
