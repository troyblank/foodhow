{
    "title": "Swedish Meat Balls",
    "meta": "Grandma's",
    "ingredients": {
        "Meat": [
            { "text": "1 lb ground beef", "type": "meat" },
            { "text": "&frac12; lb ground pork", "type": "meat" },
            { "text": "1 onion (finely diced)", "type": "produce" },
            { "text": "&frac12; carrot (grated)", "type": "produce" },
            { "text": "1 egg", "type": "perishable" },
            { "text": "4 slices of bread (torn to small pieces)", "type": "perishable" },
            { "text": "&frac12; tsp allspice", "type": "spice" },
            { "text": "&frac12; tsp pepper", "type": "spice" },
            { "text": "1 tsp salt", "type": "spice" },
            { "text": "&frac12; tsp ground sage", "type": "spice" }
        ],
        "Rest": [
            { "text": "16 oz mushrooms (chopped)", "type": "produce" },
            { "text": "1 TBSP canola oil", "type": "imperishable" },
            { "text": "1 tsp bouillon", "type": "imperishable" }
        ]
    },
    "directions": [
        { "text": "Using a deep pan fry mushrooms up an set aside." },
        { "text": "Mix all 'Meat' ingredients and form into balls." },
        { "text": "With oil brown balls over high heat in a pan and remove." },
        { "text": "Add 1 cup of water to pan and cook for 1 min." },
        { "text": "Add bouillon and balls back and then simmer covered for 1 hour." },
        { "text": "Add mushrooms." }
    ]
}
