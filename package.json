{
  "name": "foodHow",
  "version": "2.0.0",
  "packageManager": "yarn@1.22.22",
  "main": "server.js",
  "scripts": {
    "start": "yarn clean && yarn watch",
    "watch": "next dev",
    "build": "next build",
    "preview": "build && cd out && serve -p 8888",
