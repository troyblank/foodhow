{
    "title": "Venison Barbacos",
    "meta": "",
    "ingredients": [
        { "text": "3 lbs venison", "type": "uncommon" },
        { "text": "4 chipotles in adobo", "type": "imperishable" },
        { "text": "1 red onion", "type": "produce" },
        { "text": "5 garlic cloves", "type": "produce" },
        { "text": "&frac12; cup lime juice", "type": "produce" },
        { "text": "&frac12; cup vinegar", "type": "imperishable" },
        { "text": "1 quart beef stock", "type": "imperishable" },
        { "text": "&frac14; cup lard", "type": "imperishable" },
        { "text": "2 bay leaves", "type": "spice" },
        { "text": "1 tsp smoked paprika", "type": "spice" },
        { "text": "1 tsp cumin", "type": "spice" },
        { "text": "1 tsp ground cloves", "type": "spice" },
        { "text": "1 TBSP salt", "type": "spice" }
    ],
    "directions": [
        { "text": "Chop up onion and garlic." },
        { "text": "Put everything in a covered dutch oven on high and cook for 3 hours." },
        { "text": "Pull all the meat from bone and shred with forks, pour some of mixture over meat." }
    ]
}
