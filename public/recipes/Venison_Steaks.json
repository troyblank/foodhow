{
    "title": "Venison Steaks",
    "meta": "",
    "ingredients": [
        { "text": "hickory wood chips", "type": "uncommon" },
        { "text": "4 venison steaks", "type": "uncommon" },
        { "text": "&frac12; cup canola oil", "type": "imperishable" },
        { "text": "1 TBSP oregano", "type": "spice" },
        { "text": "1 &frac12; tsp garlic powder", "type": "spice" },
        { "text": "1 &frac12; tsp onion powder", "type": "spice" },
        { "text": "1 &frac12; tsp seasoned salt", "type": "spice" },
        { "text": "1 &frac12; tsp basil", "type": "spice" },
        { "text": "1 &frac12; tsp parsley", "type": "spice" },
        { "text": "&frac12; tsp pepper", "type": "spice" },
        { "text": "&frac18; tsp thyme", "type": "spice" },
        { "text": "&frac18; tsp celery seed", "type": "spice" },
        { "text": "1 &frac12; tsp sugar", "type": "imperishable" }
    ],
    "directions": [
        { "text": "Combine oil, sugar and spices together in a small bowl." },
        { "text": "Put steaks in a small container and pour oil mixture on them, let chill for 6 hours." },
        { "text": "Remove steaks from marinade and smoke with hickory at 225°." },
        { "text": "Steaks are done when they reach 160°." }
    ]
}
