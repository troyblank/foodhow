{
    "title": "Vegetable Stock",
    "meta": "",
    "ingredients": [
        { "text": "2 large onions (chopped)", "type": "produce" },
        { "text": "2 large carrots (peeled and chopped)", "type": "produce" },
        { "text": "4 stalks celery (chopped)", "type": "produce" },
        { "text": "1 large leek (trimmed)", "type": "produce" },
        { "text": "8oz mushrooms (chopped)", "type": "produce" },
        { "text": "2 granny smith apples (quartered)", "type": "produce" },
        { "text": "1 oz unflavored gelatin", "type": "imperishable" },
        { "text": "2 bay leaves", "type": "spice" },
        { "text": "2 tsp whole black peppercorns", "type": "spice" },
        { "text": "1 tsp fennel seeds", "type": "spice" },
        { "text": "1 tsp coriander seeds", "type": "spice" },
        { "text": "6 sprigs fresh parsley", "type": "produce" }
    ],
    "directions": [
        { "text": "Stir 4 cups of water with gelatin and let it sit for 10 mins." },
        { "text": "Add all ingredients into a dutch oven and add enough cold water to cover." },
        { "text": "Add gelatin water to the dutch oven." },
        { "text": "Bring to a simmer for 1 hour." },
        { "text": "Discard all large bits and strain the stock with a fine strainer and cheese cloth."},
        { "text": "Simmer strained stock for another 20 mins."}
    ]
}
